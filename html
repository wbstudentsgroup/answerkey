function matches(q,cat=null){q=(q||'').trim().toLowerCase();return DATA.subjects.filter(s=>(!cat||s.category===cat)&&(!q||s.name.toLowerCase().includes(q)||s.code.toLowerCase().includes(q)));}
function fillSubjectSelect(){const list=matches('',activeCategory);$('subjectSelect').innerHTML='<option value="">Select subject…</option>'+list.map(s=>`<option value="${s.code}">${s.name} (${s.code})</option>`).join('');$('subjectOptions').innerHTML=list.map(s=>`<option value="${s.name} (${s.code})"></option>`).join('');$('subjectSearch').value='';}
function fillDirect(){const list=DATA.subjects;$('directOptions').innerHTML=list.map(s=>`<option value="${s.name} (${s.code})"></option>`).join('');$('directSelect').innerHTML='<option value="">Search or select…</option>'+list.map(s=>`<option value="${s.code}">${s.name} (${s.code}) · ${s.category}</option>`).join('');}
function resolve(input,cat=null){let raw=(input||'').trim();if(!raw)return null;let code=raw.match(/\(([A-Z]{4})\)\s*$/i);if(code&&subjectMap.has(code[1].toUpperCase()))return subjectMap.get(code[1].toUpperCase());let exact=DATA.subjects.find(s=>s.code.toLowerCase()===raw.toLowerCase()||s.name.toLowerCase()===raw.toLowerCase());if(exact&&(!cat||exact.category===cat))return exact;let list=matches(raw,cat);return list.length===1?list[0]:null;}
function openSubject(s){if(!s){$('subjectError').classList.remove('hidden');return;} $('subjectError').classList.add('hidden');activeSubject=s.code;activeSet='A';$('result').classList.remove('hidden');$('resultName').textContent=s.name;$('resultCode').textContent='Subject Code: '+s.code+' • '+s.category;const rows=DATA.rows.filter(r=>r.code===s.code);$('rowCount').textContent=rows.length+' answer-key entries';$('sets').innerHTML=['A','B','C','D'].map(set=>`<button class="setbtn ${set===activeSet?'active':''}" data-set="${set}">Set ${set}</button>`).join('');$('sets').querySelectorAll('button').forEach(b=>b.onclick=()=>{activeSet=b.dataset.set;renderAnswers();});renderAnswers();$('result').scrollIntoView({behavior:'smooth',block:'start'});}
function renderAnswers(){const rows=DATA.rows.filter(r=>r.code===activeSubject).sort((a,b)=>a.sets[activeSet]-b.sets[activeSet]);$('sets').querySelectorAll('button').forEach(b=>b.classList.toggle('active',b.dataset.set===activeSet));const anomalies=rows.filter(r=>r.key.length>1||r.key==='No correct option').length;const singles=rows.length-anomalies;$('summary').innerHTML=`<span class="pill">Set ${activeSet}</span><span class="pill">${rows.length} listed questions</span><span class="pill">${anomalies} multiple/no-correct entries</span>`;$('answerGrid').innerHTML=rows.map(r=>{let none=r.key==='No correct option',multi=!none&&r.key.length>1;let key=none?'No correct option':r.key.split('').join(', ');return `<div class="answer ${none?'none':multi?'multi':''}"><div class="q">Question ${r.sets[activeSet]}</div><div class="key ${none?'none':multi?'multi':''}">${key}</div></div>`}).join('');$('notice').textContent='Questions are sorted from lowest to highest for the selected set. Multi-option and “No correct option” entries are highlighted; these are transcribed from the supplied PDF and are not independently confirmed exam mistakes.';}
$('showBtn').onclick=()=>{let s=resolve($('subjectSearch').value,activeCategory)||subjectMap.get($('subjectSelect').value);openSubject(s);};$('subjectSelect').onchange=()=>{let s=subjectMap.get($('subjectSelect').value);if(s)$('subjectSearch').value=`${s.name} (${s.code})`;};$('subjectSearch').addEventListener('input',()=>{let s=resolve($('subjectSearch').value,activeCategory);if(s)$('subjectSelect').value=s.code;});$('resetBtn').onclick=()=>{activeCategory='Language';activeSubject='';$('result').classList.add('hidden');renderCats();fillSubjectSelect();$('subjectError').classList.add('hidden');};$('directBtn').onclick=()=>{let s=subjectMap.get($('directSelect').value)||resolve($('directSearch').value);if(!s){let raw=$('directSearch').value.trim().toLowerCase();const candidates=matches(raw);if(candidates.length===1)s=candidates[0];}openSubject(s);};$('directSelect').onchange=()=>{let s=subjectMap.get($('directSelect').value);if(s)$('directSearch').value=`${s.name} (${s.code})`;};$('directSearch').addEventListener('input',()=>{let s=resolve($('directSearch').value);if(s)$('directSelect').value=s.code;});renderCats();fillSubjectSelect();fillDirect();
</script>
